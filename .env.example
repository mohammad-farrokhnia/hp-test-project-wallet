# api | worker | all (all = both, for local development)
APP_ROLE=api
PORT=3000
LOG_LEVEL=info

# PSP and payout
PSP_BASE_URL=http://localhost:8080
PAYOUT_BASE_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:3000
PAYOUT_WEBHOOK_SECRET=hamtapay-sim-secret
# empty = /internal/* is open; set it to require X-Internal-Api-Key
INTERNAL_API_KEY=

HTTP_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000

DEPOSIT_MIN_TOMAN=1000
WITHDRAW_MIN_TOMAN=100000
WITHDRAW_DAILY_LIMIT_TOMAN=200000000
USDT_WITHDRAW_MIN_MICRO=10000000
USDT_WITHDRAW_FEE_MICRO=1000000

DEPOSIT_EXPIRY_MINUTES=1440
DEPOSIT_CREATE_LEASE_SECONDS=30
DEPOSIT_FIRST_CHECK_SECONDS=15
DEPOSIT_UNVERIFIED_ALERT_SECONDS=120
DEPOSIT_ABANDON_AFTER_MINUTES=10
REVIEW_AFTER_MINUTES=30
WITHDRAWAL_SAFETY_NET_SECONDS=30
WITHDRAWAL_SUBMIT_LEASE_SECONDS=30
WITHDRAWAL_RETURN_WATCH_HOURS=24

OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_INTERVAL_MS=500
OUTBOX_CLAIM_SECONDS=30

JOB_PREFETCH=10
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BACKOFF_MS=1000

SWEEPER_INTERVAL_MS=5000
SWEEPER_BATCH_SIZE=100
SWEEPER_BUMP_SECONDS=30

IDEMPOTENCY_RETENTION_DAYS=7
IDEMPOTENCY_CLEANUP_INTERVAL_MINUTES=60

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
RABBITMQ_PUBLISH_RETRIES=3

APP_PORT=3000
# Simulator chaos mode: off | default | hostile  (and clock speed-up)
SIM_CHAOS=default
SIM_TIME_SCALE=1
# Debug ports on 127.0.0.1; 0 = pick any free port (docker compose port <service> <port>)
RABBITMQ_UI_PORT=0
SIMULATOR_PORT=0

# Entry point `app:$PORT`: round-robins across the api replicas.
# Rendered by the nginx image's envsubst at start; only ${PORT} is substituted.
server {
  listen ${PORT};

  # Docker's embedded DNS. Using a variable in proxy_pass makes nginx re-resolve
  # `api` every few seconds, so it follows replicas that restart or scale.
  resolver 127.0.0.11 valid=5s ipv6=off;

  # Webhook HMAC is computed over the raw body: never buffer-rewrite or alter it.
  client_max_body_size 1m;

  location / {
    set $upstream http://api:${PORT};
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;
  }
}
